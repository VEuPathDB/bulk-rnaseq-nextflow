singularity.enabled     = true
singularity.autoMounts  = true
docker.enabled          = false

process {
    executor = 'lsf'

    // HISAT2_BUILD inherits nf-core's process_high_memory label, sized for splice-aware
    // human index builds; even capped at max_memory it far exceeds our genomes' needs.
    // Genome-derived sizing is issue #14.
    withName: 'HISAT2_BUILD' {
        memory = { check_max( 12.GB * task.attempt, 'memory' ) }
        cpus   = { check_max( 1, 'cpus' ) }
    }

    // Light steps inherit nf-core label memory (process_medium 36 GB, process_single/low
    // 12 GB) far above what they use: FASTQC peaks around 670 MB. Size them to their real
    // footprint so LSF doesn't hold idle reservations. A memory kill exits 130-145, which
    // base.config's errorStrategy retries once; the `* task.attempt` doubles the retry.
    // withName beats withLabel regardless of include order, so these win over base.config.
    // Observed LSF peaks: TRIMMOMATIC ~200 MB, SPLICE_CROSS_READS <120 MB (its hash grows
    // with distinct junctions, not reads), SAMTOOLS_SORT_* ~900 MB, HISAT2_ALIGN up to 4 GB.
    withName: 'FASTQC|FASTQCCHECK|SN_FILTER|MERGE_FILTERED_STATS|FORMAT_INPUT_FROM_SRA|TRIMMOMATIC|SPLICE_CROSS_READS' {
        memory = { check_max( 2.GB * task.attempt, 'memory' ) }
    }
    withName: 'HTSEQ_COUNT.*|BEDTOOLS_GENOME_COVERAGE.*|SAMTOOLS_FILTER.*|SAMTOOLS_SORT.*|SAMTOOLS_STATS|SAMTOOLS_INDEX|SAMTOOLS_FAIDX|SAMTOOLS_BAM_TO_SAM|SAMTOOLS_VIEW_READ_OR_MATE_MAPPED' {
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
    }
    // Index size sets the floor and scales with genome; 8 GB is 2x the largest peak seen.
    withName: 'HISAT2_ALIGN' {
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
    }
}

// Threshold the module compares task.memory against to decide whether it can
// afford the --ss/--exon build. Undefined it resolves to 0, which makes the
// check always pass and removes the fallback to a plain build.
params.hisat2_build_memory = '12.GB'
